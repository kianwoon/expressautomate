# expressautomate.app — local environment
# Generated from ~/Downloads/draftproof_services/.env. DO NOT COMMIT.

# --- Hosting / deploy (reused from draftproof) ---
KOYEB_TOKEN=
GHCR_USERNAME=
GHCR_PAT=

# --- Cloudflare (DNS for expressautomate.app once registered) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCOUNT_API_TOKEN=

# --- Database (new 'expressautomate' DB on the draftproof-db instance) ---
DATABASE_URL=
DATABASE_APP_PASSWORD=
# The runtime role, which must NOT have BYPASSRLS. Tenant isolation is
# enforced by row-level security, and a bypassing role would silently
# disable it — see app/db/rls.py.
DATABASE_APP_ROLE=expressautomate_app
DATABASE_ADMIN_URL=

# --- AI extraction ---
# Both extraction models are Cerebras model ids (see below), not OpenRouter
# ones. EXTRACTION_MODEL_STRONG may be left empty: escalation then re-asks the
# fast model at a higher reasoning effort, which is the safe default. Only put
# a second model here once you have verified it accepts the request.
EXTRACTION_MODEL_FAST=gpt-oss-120b
EXTRACTION_MODEL_STRONG=
# Reasoning effort for the first pass and for the escalation (§32).
EXTRACTION_REASONING_EFFORT_FAST=low
EXTRACTION_REASONING_EFFORT_STRONG=high
# Twelve fields per vacancy, each quoting the email. Too low truncates the JSON.
EXTRACTION_MAX_TOKENS=16000
# OpenRouter is no longer on the extraction path. Kept so a deployment can move
# back to a router without rediscovering the settings.
OPENROUTER_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=90

# --- Cerebras (the relevance gate and extraction) ---
# The gate runs once per email, forever, so it has its own provider and is
# batched. Extraction joined it after the router's strict json_schema path
# failed on every email: "the compiled grammar is too large".
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_API_KEY=
CLASSIFIER_MODEL=gpt-oss-120b
# Emails per classification call, and characters of each one shown to it.
CLASSIFIER_BATCH_SIZE=20
CLASSIFIER_CHARS_PER_EMAIL=1200
# The gate's model reasons before it answers. Too low and it returns its
# reasoning and no content at all.
CLASSIFIER_MAX_TOKENS=4000
# Leave this low. At the model's default effort it reasons until the budget is
# gone and returns no answer at all.
CLASSIFIER_REASONING_EFFORT=low
# How often the supervisor looks for fetched mail to classify, and how many
# rows one sweep may claim.
CLASSIFY_SWEEP_INTERVAL_SECONDS=30
CLASSIFY_SWEEP_LIMIT=200
PROMPT_VERSION=v1
# Confidence a fully verified extraction must clear to count as `verified`
# rather than `likely`. Recalibrate when the extraction model changes.
EXTRACTION_VERIFIED_CONFIDENCE=0.8
# How long a message the relevance gate rejected is kept before purge.
NON_RECRUITMENT_RETENTION_DAYS=7
# Currencies a salary may be filed under. An unrecognised token yields no
# currency rather than a wrong one. A bare "$" is intentionally not mapped —
# it is SGD or USD depending on who wrote the mail.
SALARY_CURRENCY_CODES=SGD,USD,MYR,EUR,GBP,AUD,HKD,CNY,JPY,INR,PHP,IDR,THB
SALARY_CURRENCY_SYMBOLS=S$=SGD,RM=MYR,€=EUR,£=GBP,¥=JPY,₹=INR
# Plausibility window for a parsed salary figure, per period. A figure outside
# it means the sentence held a number that is not money, and the salary is
# refused rather than half-read. Raise the floor for annual-only markets.
SALARY_MIN_CREDIBLE=100
SALARY_MAX_CREDIBLE=10000000
# Most job orders one dashboard request returns, newest first.
OPPORTUNITIES_PAGE_LIMIT=200
# Most clients one dashboard request returns, newest first.
CLIENTS_PAGE_LIMIT=200
# Most candidates one dashboard request returns.
CANDIDATES_PAGE_LIMIT=200
CANDIDATE_ACTIVITIES_PAGE_LIMIT=200
# Upper bound on a candidate's years of experience. Generous on purpose: it is
# there to catch a mistyped figure, not to legislate a career length.
CANDIDATE_MAX_YEARS_EXPERIENCE=80
# Region used to parse a phone number that has no country code.
DEFAULT_PHONE_REGION=SG
# Leading digits that mark a personal number. A fixed-line prefix here would
# let one switchboard merge every colleague into a single candidate.
MOBILE_PREFIXES=8,9

# Domains that never identify a company — a hiring manager signing from
# gmail.com, yahoo.com, etc. represents a person, not an agency. Matching
# on those domains would file every unrelated agency's clients under one row.
# Comma-separated list; extend it without a code change.
FREE_EMAIL_DOMAINS=gmail.com,googlemail.com,hotmail.com,outlook.com,live.com,yahoo.com,yahoo.com.sg,icloud.com,me.com,proton.me,protonmail.com,aol.com,qq.com,163.com

# --- Object storage (Cloudflare R2) ---
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Cloudflare's documented value. Leave it set: the region signs the request,
# and botocore would otherwise inherit whatever AWS_DEFAULT_REGION the host
# exports, which R2 rejects.
R2_REGION=auto

# --- Candidate avatar photos ---
# Enforced on the way in, before anything is decoded.
AVATAR_MAX_UPLOAD_BYTES=5242880
# The long edge every photo is scaled down to. Avatars are shown small; storing
# a full-resolution phone photo only costs bandwidth on every open.
AVATAR_MAX_PIXEL_DIMENSION=1024
# How long a signed avatar URL stays valid. Short on purpose: the URL is an
# unauthenticated capability for as long as it lives.
AVATAR_PRESIGNED_URL_TTL_SECONDS=300
# A Pillow format name. Every upload is re-encoded to this, which is what
# strips EXIF (phone photos carry GPS).
AVATAR_STORED_FORMAT=PNG

# --- CV documents ---
# How much text one CV may contribute. This is the decompression-bomb bound
# the parser enforces, and also the length of the string every evidence offset
# indexes into, so raising it accepts both a longer prompt and a larger worker
# footprint.
CV_TEXT_MAX_CHARS=200000
# Wall clock one CV parse may occupy a worker for, model call included. The
# only thing between a single hostile page that inflates inside pypdf and a
# worker slot held for the life of the process.
CV_PARSE_TIMEOUT_SECONDS=300
# Largest CV the API will accept, counted as the bytes arrive rather than
# trusted from Content-Length.
CV_MAX_UPLOAD_BYTES=10485760
# How long a CV download link stays valid. A signed URL is a capability, so
# short: one that outlives its session is a capability nobody revoked.
CV_PRESIGNED_URL_TTL_SECONDS=300
# How many CVs one agency may upload per UTC day. Each upload buys a model
# call, so this is a spend ceiling before it is anything else. Counted as the
# tenant's candidate_documents rows since midnight — there is no counter.
CV_DAILY_PARSE_QUOTA=200

# --- Candidate spreadsheet imports ---
# Largest spreadsheet the API will accept, counted as the bytes arrive rather
# than trusted from Content-Length. Bigger than a CV because a five-hundred
# person roster with a career history beside it is the ordinary case here.
IMPORT_MAX_UPLOAD_BYTES=20971520
# How many data rows one sheet may hold. The bound that stops an import
# building an unbounded list of dicts in a worker, and the number quoted back
# to a recruiter whose file exceeds it.
IMPORT_MAX_ROWS=5000
# How much an uploaded XLSX's zip members may inflate to in total. A
# spreadsheet is a decompression-bomb vector exactly as a DOCX is: a member's
# declared uncompressed size is a claim, not a fact.
IMPORT_INFLATE_BUDGET_BYTES=209715200
# How long a link to an import's error report stays valid. Short: the report
# names real candidates.
IMPORT_PRESIGNED_URL_TTL_SECONDS=300
# Wall clock one import may occupy an arq worker for. A run this cuts short is
# left at `parsing`, which rescan_stuck re-enqueues.
IMPORT_JOB_TIMEOUT_SECONDS=600
# How many times a worker may pick one import up before parking it in `failed`.
# rescan_stuck re-enqueues anything left non-terminal, which is right for a
# crashed worker and wrong for a file that crashes the apply every time.
IMPORT_MAX_ATTEMPTS=3

# --- Redis (Upstash, shared; used for the ingestion queue) ---
# Use the rediss:// form. The DSN carries a password, and the plaintext scheme
# would put it on the wire.
REDIS_URL=
# arq polls, and Upstash bills per command, so a tight loop costs money every
# second the system is idle. Latency here is worth a couple of seconds.
ARQ_POLL_DELAY_SECONDS=2.0
ARQ_MAX_JOBS=10
ARQ_MAX_TRIES=5

# --- Dashboard live updates (SSE over the same Redis) ---
# Channel prefix; the tenant id is appended, so one Redis can serve several
# environments without staging waking production's dashboards. Blank REDIS_URL
# simply means no live updates — ingestion is unaffected.
EVENTS_CHANNEL_PREFIX=ea:events:
# Keep-alive cadence for an open stream. Koyeb's proxy reaps an idle
# connection, and the browser cannot tell that from a quiet mailbox.
EVENTS_HEARTBEAT_SECONDS=20.0

# --- Microsoft Entra ID / Graph  (NOT YET PROVISIONED — you must create these) ---
# Azure Portal > Entra ID > App registrations > New registration
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
MS_REDIRECT_URI=
MS_IDENTITY_SCOPES=
MS_MAILBOX_SCOPES=
MS_WEBHOOK_CLIENT_STATE=
# Two keys, not one: consent is incremental. Sign-in asks for the identity set;
# mailbox access is requested only when a user connects a mailbox. Leaving
# either blank still signs in successfully and fails much later, on the first
# mail read — see docs/setup.md.
MS_IDENTITY_SCOPES=openid profile email User.Read offline_access
MS_MAILBOX_SCOPES=Mail.Read
# Both must be publicly reachable HTTPS before a subscription can be created —
# Graph validates each with a handshake at creation time and refuses if it
# fails. There is deliberately no shared webhook secret: each subscription
# carries its own random clientState, generated at creation.
MS_WEBHOOK_NOTIFICATION_URL=
MS_WEBHOOK_LIFECYCLE_URL=
# The mailbox consent lands here, separate from the sign-in callback — sharing
# it would create a session instead of a mailbox. Register BOTH redirect URIs
# in the Entra app registration; Entra rejects any it has not been told about.
MS_MAILBOX_REDIRECT_URI=
# How long a tenant keeps source email by default (spec: Retention).
DEFAULT_RETENTION_MONTHS=24

# --- Microsoft Graph ---
GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
GRAPH_TIMEOUT_SECONDS=30
# Only used when Graph throttles without a parseable Retry-After.
GRAPH_DEFAULT_RETRY_AFTER_SECONDS=10
# The notification endpoint is unauthenticated and public; this bounds the work
# one request can demand. Graph's own batches are far smaller.
GRAPH_MAX_NOTIFICATIONS_PER_REQUEST=200
# What to ask for. Graph may grant less, so the renewal point is derived from
# the expiry it actually returns, never from this value.
GRAPH_SUBSCRIPTION_REQUEST_MINUTES=4230
# Must be within (0, 1]: the renewal point is a weighted midpoint, and above 1
# it would fall after the expiry it exists to precede.
GRAPH_SUBSCRIPTION_RENEW_MARGIN=0.5

# --- Initial mailbox sync (plan §6.2) ---
# Graph delta filtered by receivedDateTime is not a bulk export mechanism.
# Whichever limit is hit first stops the walk; the onboarding UI must not offer
# a start date beyond the lookback.
INITIAL_SYNC_MAX_MESSAGES=5000
INITIAL_SYNC_MAX_LOOKBACK_DAYS=90
# Settings lets a user reach further back later, which re-runs the backfill.
# An extension must gain at least this many days to be worth that walk.
LOOKBACK_EXTENSION_MIN_DAYS=1
LOOKBACK_EXTENSION_MIN_FRACTION=0.1

# --- Recovery sweeps (plan §8, §9) ---
# Two grace periods: a queue hop should be quick, but a fetch or an extraction
# legitimately takes longer. Sweeping both on the same clock would duplicate
# work that is still in flight.
RESCAN_PENDING_MINUTES=5
RESCAN_WORKING_MINUTES=15
RESCAN_INTERVAL_SECONDS=300
RENEW_INTERVAL_SECONDS=900
DELTA_SYNC_INTERVAL_SECONDS=600
# Backstop for an active mailbox that somehow has no subscription — it would
# otherwise look healthy and receive nothing. Hourly is enough for a state that
# should never arise.
ENSURE_SUBSCRIPTIONS_INTERVAL_SECONDS=3600

# --- App ---
# Empty: one Koyeb service serves everything on route `/`, so nothing
# strips a prefix. Set only if something is put in front.
API_ROOT_PATH=
APP_ENV=
APP_SECRET_KEY=
TOKEN_ENCRYPTION_KEY=
FRONTEND_ORIGIN=
SQL_ECHO=

# --- Google sign-in (identity only; no Gmail scope) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- Sync activity log (the dashboard's "Recent sync activity" panel) ---
# Events retained per mailbox. Trimmed by the writer, in the same transaction
# as the insert, so the table is bounded without a purge on a timer.
SYNC_ACTIVITY_KEEP_PER_MAILBOX=200
# Events one dashboard request returns, newest first.
SYNC_ACTIVITY_PAGE_LIMIT=50

# --- Client shorthand glossary (per-agency; C/F, o/o, C/O ...) ---
# Offer the shipped Singapore starter codes to a tenant the first time they
# read their glossary. Turning this off never removes codes already seeded.
GLOSSARY_SEED_STARTERS=true
# Ceilings on one glossary row. A code is shorthand, not prose.
GLOSSARY_CODE_MAX_LENGTH=32
GLOSSARY_MEANING_MAX_LENGTH=500

# --- Glossary scanning (deterministic decoding of client shorthand) ---
# Shortest code the scanner will look for. A one-character entry matches
# somewhere in almost every email, so decoding it would decorate every job
# order with a demographic claim the client never made.
GLOSSARY_MIN_CODE_LENGTH=2
# Punctuation allowed to sit against a code. Anything absent here — `/`, `-`,
# letters, digits — means the token is longer than the match, which is what
# keeps `C/F` from being found inside `ABC/FGH`. Widening this widens decoding.
GLOSSARY_BOUNDARY_CHARS=(),;:!?"'“”‘’[]{}<>*—–…
# Punctuation that ends a code only when nothing alphanumeric follows it, so
# "we want C/F." decodes and "C.F.M" is not decoded as its first two thirds.
GLOSSARY_WEAK_BOUNDARY_CHARS=.
# Glossary rows one scan compiles patterns for, bounding per-email cost.
GLOSSARY_MAX_CODES=500

# --- Notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_WEBHOOK_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v21.0
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_OPPORTUNITY_NEW=
WHATSAPP_TEMPLATE_OPPORTUNITY_REVIEW=
WHATSAPP_TEMPLATE_LINK_CODE=
WHATSAPP_TEMPLATE_LANG=en
NOTIFY_RATE_CAP_PER_HOUR=6
NOTIFY_LINK_TOKEN_TTL_MINUTES=15
NOTIFY_MAX_ATTEMPTS=5
NOTIFY_MAX_FAILURES=3
NOTIFY_OPT_IN_MAX_PER_HOUR=5
NOTIFY_VERIFY_MAX_PER_HOUR=10
NOTIFY_VERIFY_WINDOW_SECONDS=3600
NOTIFY_SWEEP_INTERVAL_SECONDS=300
NOTIFY_DELIVERY_STALE_MINUTES=10
NOTIFY_FLUSH_LIMIT=200

# --- Candidate sourcing ---------------------------------------------------
# How much each signal counts when ranking a candidate against a job order.
# Only the ratios matter; the total is a weighted mean over the components
# that had data, so this set never has to sum to anything.
SOURCING_WEIGHT_TITLE=3.0
SOURCING_WEIGHT_SKILLS=3.0
SOURCING_WEIGHT_EMPLOYER=1.0
SOURCING_WEIGHT_SALARY=2.0
SOURCING_WEIGHT_TENURE=1.0
SOURCING_WEIGHT_RECENCY=1.0
# Experience at which the tenure signal is already full marks.
SOURCING_TENURE_FULL_MONTHS=120
# How long since the last role before the recency signal reaches zero.
SOURCING_RECENCY_STALE_MONTHS=36
SOURCING_SCORE_DECIMAL_PLACES=4
# How many of the top-scoring candidates get a model-written explanation.
SOURCING_EXPLAIN_TOP_N=10
# How many matches a run keeps. Everything eligible is scored; only this many
# of the best are stored and shown.
SOURCING_MAX_MATCHES=20
# The wall clock one sourcing run may occupy an arq worker for.
SOURCING_JOB_TIMEOUT_SECONDS=600.0
# How many times a worker may pick one run up before parking it in `failed`.
SOURCING_MAX_ATTEMPTS=3
# How many runs one agency may start in a UTC day — a spend ceiling.
SOURCING_DAILY_RUN_QUOTA=100

# --- WA gateway (Baileys, per-recruiter outbound WhatsApp) ------------------
# Distinct from the WHATSAPP_* block above, which is Meta Cloud API
# notifications TO recruiters. Nothing here shares that prefix.
#
# These are consumed by the Node service in `gateway/`, not by
# app.core.config.Settings — so backend/tests/test_deployment.py does NOT
# police them (it walks Settings.model_fields). They are listed here because
# an operator configures from this file, and on Koyeb they are set by hand on
# the `gateway` service, which starts with zero env vars.
#
# Shared secret FastAPI presents as `Authorization: Bearer …` on every gateway
# call, and the gateway presents back on its `POST /api/wa/internal/status`
# callback. REQUIRED — the gateway refuses to start without it, and
# `app.core.config.Settings` (WA_GATEWAY_SHARED_SECRET) now reads it too, so
# `tests/test_deployment.py` polices this one. Must be set identically on the
# `gateway` and `api` services. Generate with:
#   openssl rand -base64 48
WA_GATEWAY_SHARED_SECRET=
# Port the gateway listens on. Must match the Koyeb health-check port; a
# health check pointing at the wrong port leaves the deploy PENDING.
WA_GATEWAY_PORT=7300
# Interface to bind. 0.0.0.0 so the Koyeb service mesh can reach it.
WA_GATEWAY_HOST=0.0.0.0
# Where FastAPI reaches the gateway (private mesh address, no public route).
# Read by `app.core.config.Settings` (WA_GATEWAY_URL) since P3 —
# `backend/app/services/wa_gateway.py` is the client. Never hardcoded.
WA_GATEWAY_URL=
# How long `api` waits on a gateway call before treating it as unreachable.
WA_GATEWAY_TIMEOUT_SECONDS=5.0
# Messages one recruiter may send per UTC day through their own paired
# WhatsApp (plan §9). Counted per user, because WhatsApp bans the number and
# each recruiter pairs their own. Read by `app.core.config.Settings`
# (WA_SEND_DAILY_LIMIT), so `tests/test_deployment.py` polices it. Raise it
# deliberately, not reactively — a personal account that suddenly sends
# hundreds is the pattern WhatsApp acts on.
WA_SEND_DAILY_LIMIT=50
# Floor between two sends on the same session (plan §9, P5), with jitter so a
# burst does not become a metronome. Enforced as a refusal (429), not a
# queue — a queued send would have to survive a redeploy, and Baileys sockets
# do not (plan §2). Primary enforcement is `app.core.config.Settings`
# (WA_SEND_MIN_INTERVAL_SECONDS) — the pre-dispatch transaction locks
# `wa_sessions` for the cap check anyway, so it also serialises spacing there
# — so `tests/test_deployment.py` polices this one. `gateway/` (src/config.ts)
# also reads it as a second, independent line of defence against a caller
# that bypasses the API; both default to 30.
WA_SEND_MIN_INTERVAL_SECONDS=30
# A `pending` send row (P5) older than this was left by a process that died
# mid-dispatch; the liveness sweep resolves it to `unknown` — never `failed`,
# per §15. Comfortably above WA_GATEWAY_TIMEOUT_SECONDS so a send merely slow
# is never swept out from under the request still handling it.
WA_SEND_STALE_PENDING_MINUTES=10
# How often the supervisor runs that sweep.
WA_SWEEP_INTERVAL_SECONDS=120
# Background liveness sweep (plan §6): a `connected`/`reconnecting` session
# whose last background check is older than this (or has never had one) is
# due to be asked again. The sweep only asks — the gateway's own
# POST /api/wa/internal/status callback stays the only writer of `status`.
WA_LIVENESS_CHECK_STALE_MINUTES=15
# How often the supervisor runs the liveness sweep.
WA_LIVENESS_SWEEP_INTERVAL_SECONDS=180
# Bound on sessions claimed per sweep call.
WA_LIVENESS_SWEEP_LIMIT=200
# Consumed by `gateway/` (src/config.ts), not Settings — same reasoning as
# WA_GATEWAY_SHARED_SECRET's header above. Where the gateway pushes
# `POST /api/wa/internal/status` (private mesh address of the `api` service).
# Optional: an unset value degrades to "no SSE nudge, settings page falls
# back to its poll floor" rather than refusing to start (plan §5).
WA_GATEWAY_API_CALLBACK_URL=
