{
  "name": "expressautomate-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "WA gateway (Baileys) — P1 skeleton. See docs/superpowers/specs/2026-07-29-baileys-gateway-plan.md",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json --noEmit && LOG_LEVEL=silent node --import tsx --test src/*.test.ts"
  },
  "dependencies": {
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
