# Local test environment, mirroring the `test` job in .github/workflows/backend.yml.
#
# The repo-root .env points at the live Koyeb database, and the suite creates
# roles, toggles RLS, and deletes rows. `tests/conftest.py` refuses to run
# against a non-local host for exactly that reason. Source this first:
#
#   set -a; source .env.test; set +a
#   uv run alembic upgrade head
#   uv run pytest
#
# Environment variables take precedence over the .env file in pydantic-settings,
# so sourcing this overrides the live DSNs without editing anything.
#
# Port 5433, not 5432: a homebrew postgresql@14 already holds 5432 on this
# machine, and the project targets 16. Start the container with:
#
#   docker run --rm -d -p 5433:5432 -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=expressautomate --name ea-test-db postgres:16
#
# No value here is a secret. They are the same placeholders CI uses.

APP_ENV=test
APP_SECRET_KEY=test-not-a-real-secret
TOKEN_ENCRYPTION_KEY=test-not-a-real-key
FRONTEND_ORIGIN=http://localhost:3000

DATABASE_APP_ROLE=expressautomate_app
DATABASE_APP_PASSWORD=test-app-password
DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5433/expressautomate
DATABASE_URL=postgresql://expressautomate_app:test-app-password@localhost:5433/expressautomate

# Public Graph permission names, and the real ones, so the suite exercises the
# same consent split production does. An unset key yields an empty scope list —
# the failure tests/test_scopes.py exists to catch.
# Quoted: these carry spaces, and `source` would otherwise run "profile" as a
# command and leave the scope list truncated to "openid".
MS_IDENTITY_SCOPES="openid profile email User.Read offline_access"
MS_MAILBOX_SCOPES="Mail.Read"
GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

# Parsed at import time by app.workers.settings, which builds arq's RedisSettings
# in its class body — the module is unimportable without a valid DSN. Nothing in
# the suite connects; the queue is always faked.
REDIS_URL=redis://localhost:6379

# --- Notifications ---
# Placeholders. The channel clients are faked in tests; these exist so the
# settings object is constructible and template names are never empty strings.
TELEGRAM_BOT_TOKEN=test-bot-token
TELEGRAM_BOT_USERNAME=expressautomate_test_bot
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_WEBHOOK_SECRET=test-webhook-secret
WHATSAPP_ACCESS_TOKEN=test-wa-token
WHATSAPP_PHONE_NUMBER_ID=100000000000000
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v21.0
WHATSAPP_APP_SECRET=test-app-secret
WHATSAPP_VERIFY_TOKEN=test-verify-token
WHATSAPP_TEMPLATE_OPPORTUNITY_NEW=opportunity_new
WHATSAPP_TEMPLATE_OPPORTUNITY_REVIEW=opportunity_needs_review
WHATSAPP_TEMPLATE_LINK_CODE=link_verification_code
WHATSAPP_TEMPLATE_LANG=en
NOTIFY_RATE_CAP_PER_HOUR=6
NOTIFY_LINK_TOKEN_TTL_MINUTES=15
NOTIFY_MAX_ATTEMPTS=5
NOTIFY_MAX_FAILURES=3
NOTIFY_OPT_IN_MAX_PER_HOUR=5
NOTIFY_SWEEP_INTERVAL_SECONDS=300
NOTIFY_DELIVERY_STALE_MINUTES=10
NOTIFY_FLUSH_LIMIT=200
CLIENT_DISCOVERY_STALE_PENDING_MINUTES=10
CLIENT_DISCOVERY_SWEEP_INTERVAL_SECONDS=300
